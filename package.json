{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test ./src",
    "test:integration": "bun test ./test/integration",
    "test:load": "bun run test/load/run-load.ts",
    "migration:up": "bun run src/platform/database/migrate.ts up",
    "migration:down": "bun run src/platform/database/migrate.ts down",
    "migration:list": "bun run src/platform/database/migrate.ts list",
    "queues:provision": "bun run src/platform/messaging/provision-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
