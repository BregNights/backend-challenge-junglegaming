# HTTP
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false

# Papéis que esta instância executa (separados por vírgula): api, sqs-consumer, outbox-publisher, pending-reference-worker
APP_ROLES=api,sqs-consumer,outbox-publisher,pending-reference-worker

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# SQS (MiniStack localmente)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
# Long polling; fica abaixo de SHUTDOWN_GRACE_MS, porque o shutdown espera os pollings em vez de abortá-los
SQS_RECEIVE_WAIT_SECONDS=5
# Backoff de visibilidade após falha transitória: base * 2^(receiveCount - 1), com teto
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=300
# Loops de recebimento por réplica (2 foi o melhor ponto medido no teste de carga)
SQS_CONSUMER_CONCURRENCY=2

# Workers
SHUTDOWN_GRACE_MS=10000
OUTBOX_POLL_INTERVAL_MS=500
# Eventos reivindicados por transação, publicados em chamadas paralelas de até 10
OUTBOX_BATCH_SIZE=100
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_TTL_MS=1800000

# Pontos de crash só para testes (crash-after-commit | crash-after-publish). Nunca defina em produção.
# FAULT_INJECTION=
